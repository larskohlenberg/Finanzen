.DS_Store
**/.DS_Store
**/.htaccess

node_modules/
**/node_modules

.superpowers/
**/.superpowers/
*.pid

# Python-Bytecode (lokale Hilfsskripte)
__pycache__/
*.pyc

# Lokale Tooling-/Agenten-Verzeichnisse
# Agent-Definitionen sind Projektkonfiguration (Modell und Effort) und gehoeren
# ins Repo. Deshalb der Inhalt statt des Verzeichnisses: bei ".claude/" steigt
# git nicht hinein und jede Ausnahme darunter liefe ins Leere.
.claude/*
!.claude/agents/
!.claude/skills/
.codex/

# Betriebsregeln und MCP-Anbindung gehoeren der jeweiligen Installation
# (Vorlage in AGENTS.md, Beispiel in .mcp.json.beispiel).
AGENTS.local.md
.mcp.json
.stitch/
.worktrees/

# Produktive App-Daten und Belege bleiben lokal.
# Nur die Ordnerstruktur (.gitkeep) und strukturbeschreibende README.md
# werden versioniert; echte Daten nicht.
app/data/**
!app/data/**/
!app/data/**/.gitkeep
!app/data/**/README.md
# Demodaten sind absichtlich fiktiv und werden fuer Vorfuehrungen versioniert.
!app/data/demo/**
!app/data/demo-belege/**
# Inbox, Importprofile und Papierkorb eines Demo-Laufs sind Arbeitsstand.
app/data/demo/inbox/
app/data/demo/import-profile/
app/data/demo/papierkorb/
**/.schreibsperre*
# Echtbestand komplett (Ordner oder nach der Umstellung ein Symlink) samt
# Generationen, Sicherung und Zwischenstaenden der Umstellung (E1 Schritt 5):
# auch .gitkeep/README.md darin gehoeren nicht ins Repo. Ein ignorierter Ordner
# wird nicht betreten, die Ausnahmen oben greifen darin also nicht.
app/data/master
app/data/*.gen/
app/data/*.ordner-*/
app/data/*.zurueck/
app/data/*.link-*
app/Belege/**
!app/Belege/**/
!app/Belege/**/.gitkeep
!app/Belege/**/README.md

# Runde-1-Excel-Archiv enthaelt echte Finanzdaten und bleibt lokal.
archiv/

# Versionsstand, schreibt ops/aktualisieren.sh beim Deploy.
app/version.json
# Sitzungsschutz (Logout-URL, Sperrzeit), schreibt ops/aktualisieren.sh aus app.env.
app/sitzung.json

# Typpruefung (npm run typen), lokal installiertes TypeScript
.typpruefung/

# Wiederanlauf-Marken des Inbox-Laufs (Importauftraege), auch in der Demo-Inbox
**/inbox/.auftraege/

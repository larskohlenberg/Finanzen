{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transfers.schema.json",
  "title": "Transfers",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["transfer_id", "betrag", "typ"],
    "properties": {
      "transfer_id": { "type": "string", "pattern": "^TRF-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "betrag": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
      "typ": { "type": "string", "enum": ["intern", "extern"] },
      "abgang_transaktion_id": { "type": "string", "pattern": "^TXN-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "zugang_transaktion_id": { "type": "string", "pattern": "^TXN-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
      "gegenseite_typ": { "type": "string", "enum": ["bar", "extern_familie", "extern_sonstiges"] },
      "begruendung": { "type": "string", "minLength": 1 }
    }
  }
}

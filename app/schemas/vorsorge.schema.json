{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vorsorge",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["vorsorge_id", "art", "name", "person_id", "status", "kapitalbildend"],
    "additionalProperties": false,
    "properties": {
      "vorsorge_id": { "type": "string", "pattern": "^VS-\\d{3,}$" },
      "art": { "type": "string", "enum": ["lebensversicherung", "rentenversicherung", "gesetzliche-rente", "betriebsrente", "riester", "ruerup", "schutzversicherung", "sonstig"] },
      "name": { "type": "string", "minLength": 1 },
      "versicherungsnummer": { "type": "string", "minLength": 1, "description": "Versicherungs- bzw. Vertragsnummer laut Vertragsunterlagen; steht auf der Kachel als eigene Zeile unter dem Namen, nicht im Namen selbst." },
      "person_id": { "type": "string", "pattern": "^PER-\\d{3,}$" },
      "status": { "type": "string", "enum": ["aktiv", "gekuendigt", "ruhend", "geplant", "laufend", "beendet"] },
      "kapitalbildend": { "type": "boolean" },
      "kapitalwahl": { "type": "string", "enum": ["offen", "monatsrente", "kapital"] },
      "sparte": { "type": "string", "enum": ["kfz", "haftpflicht", "rechtsschutz", "hausrat", "wohngebaeude", "photovoltaik", "berufsunfaehigkeit", "pflege", "krankenzusatz", "unfall", "risikoleben", "reise", "sonstige"], "description": "Versicherungssparte; erscheint als Etikett auf der Versicherungskachel." },
      "geprueft_am": { "type": "string", "format": "date" },
      "leistung_beginn": { "type": "string", "format": "date" },
      "ersetzt_vorsorge_id": { "type": "string", "pattern": "^VS-\\d{3,}$" },
      "aktiv_bis": { "type": "string", "format": "date" },
      "quelle_hinweis": { "type": "string" },
      "quelle_standdatum": { "type": "string", "format": "date" },
      "bemerkung": { "type": "string" },
      "beitragsbefreiung": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["bu", "arbeitslosigkeit"] }, "description": "Im Vertrag vereinbarte Beitragsbefreiung bei Berufsunfaehigkeit (bu) und/oder Arbeitslosigkeit. Ein Szenario-Ereignis gleichen Falls laesst die Beitraege dieses Vertrags entfallen." },
      "dynamik": {
        "type": "object",
        "description": "Beitragsdynamik: jaehrlicher Erhoehungstermin und Entscheidungen je Termin. Fristen zum Widerspruch stehen in fristen.json.",
        "required": ["termin"],
        "additionalProperties": false,
        "properties": {
          "termin": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "Erhoehungstermin im Jahr als MM-TT." },
          "erlischt_nach": { "type": "integer", "minimum": 1, "description": "Widersprueche in Folge, nach denen das Dynamikrecht erlischt (laut Vertrag; ohne Angabe 3)." },
          "verlauf": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["termin", "entscheidung"],
              "additionalProperties": false,
              "properties": {
                "termin": { "type": "string", "format": "date" },
                "entscheidung": { "type": "string", "enum": ["angenommen", "abgelehnt", "offen"] },
                "bemerkung": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

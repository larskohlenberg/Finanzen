# /etc/finanzen/app.env — Werte fuer finanzen-app.service.
# Platzhalter (Dokumentations-IP/-Domain) durch die echten Werte ersetzen;
# die echten Werte gehoeren nicht ins Repo.

# Adresse, auf der der App-Server lauscht (VM-Adresse oder 0.0.0.0).
FINANZEN_HOST=0.0.0.0
FINANZEN_PORT=8080
# Nur Anfragen von dieser IP (Reverse-Proxy) mit Remote-User werden bedient.
FINANZEN_PROXY_IP=192.0.2.10
# Origin, unter der die App im Browser laeuft (fuer Upload- und Host-Pruefung).
FINANZEN_ORIGIN=https://finanzen.example.org

# Sitzungsschutz der App (liest ops/aktualisieren.sh, schreibt app/sitzung.json).
# Logout-URL des Anmeldedienstes mit Ruecksprung zur App (rd url-kodiert).
# Ohne Wert sperrt die App bei Inaktivitaet nur und laedt neu, ohne Abmelden.
FINANZEN_ABMELDEN_URL=https://auth.example.org/logout?rd=https%3A%2F%2Ffinanzen.example.org%2F
# Minuten ohne Maus/Tastatur/Touch/Scroll bis zur Sperre (Standard 5).
FINANZEN_SPERRE_MINUTEN=5

# Datenort ausserhalb des Checkouts (ADR 0036, docs/betrieb.md). Ohne Wert
# liegen die Daten in /opt/finanzen/app/data und /opt/finanzen/app/Belege.
# Mit Wert in der Unit ReadWritePaths=<Datenort>/inbox setzen.
#FINANZEN_DATEN=/var/lib/finanzen

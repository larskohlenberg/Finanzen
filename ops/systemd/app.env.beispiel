# /etc/finanzen/app.env — Werte fuer finanzen-app.service.
# Platzhalter (Dokumentations-IP/-Domain) durch die echten Werte ersetzen;
# die echten Werte gehoeren nicht ins Repo.

# Adresse, auf der der App-Server lauscht (VM-Adresse oder 0.0.0.0).
FINANZEN_HOST=0.0.0.0
FINANZEN_PORT=8080
# Nur Anfragen von dieser IP (Reverse-Proxy) mit Remote-User werden bedient.
FINANZEN_PROXY_IP=192.0.2.10
# Origin, unter der die App im Browser laeuft (fuer Upload- und Host-Pruefung).
FINANZEN_ORIGIN=https://finanzen.example.org
